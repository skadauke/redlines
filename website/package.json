{
  "name": "redlines-website",
  "version": "0.0.0",
  "private": true,
  "description": "Product website: a static-exported Next.js site, deployed to GitHub Pages.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "embed": "pnpm --dir .. --filter @redlines/website-embed build",
    "embed:watch": "pnpm --dir .. --filter @redlines/website-embed watch",
    "embed:check": "pnpm --dir .. --filter @redlines/website-embed check-size",
    "build": "next build",
    "test": "node --test \"scripts/*.test.mjs\"",
    "compare:check": "node scripts/compare-check.mjs",
    "icons:check": "node scripts/icons-check.mjs",
    "make-social": "node scripts/make-social.mjs",
    "sync-release": "node scripts/sync-release.mjs",
    "sync-release:check": "node scripts/sync-release.mjs --check-only",
    "perf": "node scripts/perf.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
