{
  "name": "@redlines/website-embed",
  "version": "0.0.0",
  "private": true,
  "description": "The editor with the review interface and a scripted agent, bundled for the website's demos. Not an API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "check-size": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-size.ts",
    "size": "vite build && pnpm run check-size",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@redlines/agent-tools": "workspace:*",
    "@redlines/agents": "workspace:*",
    "@redlines/editor": "workspace:*",
    "@redlines/format": "workspace:*",
    "@redlines/formatting": "workspace:*",
    "@redlines/plugin-api": "workspace:*",
    "@redlines/review": "workspace:*",
    "@redlines/themes": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
