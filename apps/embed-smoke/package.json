{
  "name": "@redlines/embed-smoke",
  "version": "0.0.0",
  "private": true,
  "description": "A minimal embed of the Redlines core and review, to keep the core embeddable. Not shipped.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "size": "vite build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-size.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@redlines/editor": "workspace:*",
    "@redlines/plugin-api": "workspace:*",
    "@redlines/review": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.3.4"
  }
}
