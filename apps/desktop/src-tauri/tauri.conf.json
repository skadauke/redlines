{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redlines",
  "identifier": "md.redlines.editor",
  "build": {
    "beforeDevCommand": "scripts/build-redlines && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Redlines",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 }
      },
      {
        "label": "install",
        "create": false,
        "url": "install.html",
        "title": "Install Redlines",
        "width": 440,
        "height": 232,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https: http: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https: http: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "deb", "rpm", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "icons/family/*.png": "icons/family/" },
    "externalBin": ["binaries/redlines"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0Njc1QjQ3OEMxNkVEMzgKUldRNDdSYU1SMXRuRklUR0RaajZXejluZUZTbHVJNk5XTWlmUG9Zb2l4S0tKdUlSeGkwUHlxZmUK",
      "endpoints": ["https://github.com/skadauke/redlines/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
