#!/usr/bin/env python3
"""Builds the Quick Look extensions that go inside the app (apps/desktop/quicklook): the preview of
Markdown, R Markdown and Quarto files in the Clean view, which macOS draws for a press of Space on
one in Finder, and in Mail, Spotlight and the Open dialog (#316), and the thumbnails of them that
Finder's icons, columns and gallery show (#345).

    scripts/build-quicklook [--sign-only] [--check | --check-only] [--check-app APP [--signed]]

With no argument it bundles the scripts that the extensions run (quicklook/src, in JavaScriptCore),
compiles each extension for Apple silicon and Intel (Swift, with no Xcode project: swiftc), and
assembles quicklook/build/RedlinesPreview.appex and quicklook/build/RedlinesThumbnail.appex. Each is
signed there, with the sandbox entitlement and the hardened runtime: ad hoc, or with the identity in
APPLE_SIGNING_IDENTITY when that is set. `bundle.macOS.files` in src-tauri/tauri.conf.json copies
them to Redlines.app/Contents/PlugIns, and Tauri signs the app around them without touching what is
inside (it signs the app and the programs it copies, never a plug-in), so they must be signed when
`tauri bundle` runs, and with the same identity as the app.

`pnpm build` runs this, so `tauri build` makes the extensions as part of compiling the app, as it
makes the `redlines` program (scripts/build-redlines). `pnpm tauri dev` doesn't bundle, and needs
none. The release workflow compiles the app before any credential is unpacked, so it signs the
extensions afterwards: `--sign-only` signs the built extensions again with APPLE_SIGNING_IDENTITY,
with a secure timestamp, which notarization asks for.

`--check` builds the extensions, then renders the folder's fixtures (quicklook/fixtures) with
`preview-render`, a command line that runs the same Swift and the same scripts as the extensions in
the system's JavaScriptCore, draws the thumbnails, and checks each extension's layout, its
Info.plist, its entitlements and its signature; `--check-only` does the checks of what is built,
without building it again. `--check-app APP` checks the extensions inside a built app: where they
are, that each holds both architectures, that it is signed with the hardened runtime and the sandbox,
and, with `--signed`, that it is signed with a Developer ID and a secure timestamp, by the team that
signed the app, and that the app's own seal holds with them inside.

The extensions are for the Mac: on any other system this does nothing, so that the rest of the
workspace builds there as it always did.
"""

from __future__ import annotations

import plistlib
import platform
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, NoReturn, Optional, Tuple

DESKTOP = Path(__file__).resolve().parent.parent
QUICKLOOK = DESKTOP / "quicklook"
SWIFT = QUICKLOOK / "swift"
FIXTURES = QUICKLOOK / "fixtures"
BUILD = QUICKLOOK / "build"
CARGO_TOML = DESKTOP / "src-tauri" / "Cargo.toml"
ROLLDOWN = QUICKLOOK / "node_modules" / ".bin" / "rolldown"

HARNESS = BUILD / "preview-render"
HARNESS_ENTITLEMENTS = SWIFT / "harness" / "preview-render.entitlements"

# The format library's patterns use regular-expression lookbehind, which JavaScriptCore has from
# Safari 16.4, that is macOS 13.3: before it the scripts don't even parse. (Its array methods,
# toSorted and the rest, came with 13.0.)
MINIMUM_MACOS = "13.3"
ARCHS = ["arm64", "x86_64"]

# The types of the files that the extensions handle. Markdown has two on macOS 27: the one macOS
# exports, which `.md` files have and Redlines imports for a macOS that doesn't know it, and the one
# that other apps declare (document-types.plist claims both). R Markdown and Quarto have none: macOS
# gives their files a dynamic type, made from the extension.
MARKDOWN_TYPES = ["net.daringfireball.markdown", "public.markdown"]
EXTENSIONS_WITH_NO_TYPE = ["qmd", "rmd"]

# The theme's fonts that the thumbnails are drawn in (Carlito for the text, Cousine for code, design
# §6.6), as the files of @fontsource that the preview inlines in its page.
FONT_FILES: Dict[str, List[str]] = {
    "carlito": ["carlito-latin-400-normal.woff2", "carlito-latin-700-normal.woff2"],
    "cousine": ["cousine-latin-400-normal.woff2"],
}


@dataclass(frozen=True)
class Extension:
    """One of the extensions that go in the app: what it is called, what it carries and what it may."""

    # The program's name, and the folder's: RedlinesPreview.appex.
    name: str
    # An extension's identifier starts with the app's (md.redlines.editor), as an extension's must.
    bundle_id: str
    title: str
    # NSExtensionPointIdentifier and NSExtensionPrincipalClass.
    point: str
    principal: str
    # The script in its Resources that the Swift runs in JavaScriptCore.
    script: str
    # The Swift files it is built from, in the swift folder, and the frameworks it links.
    sources: Tuple[str, ...]
    frameworks: Tuple[str, ...]
    entitlements: Path
    # The entitlements it asks for, which the checks read back from the signature.
    granted: Tuple[str, ...]
    # NSExtensionAttributes, besides the types it handles.
    attributes: Dict[str, object]
    # Whether it carries the theme's font files, in Resources/fonts.
    fonts: bool = False

    @property
    def appex(self) -> Path:
        return BUILD / f"{self.name}.appex"

    @property
    def in_app(self) -> Path:
        # Inside Redlines.app/Contents, where bundle.macOS.files puts it.
        return Path("PlugIns") / f"{self.name}.appex"


PREVIEW = Extension(
    name="RedlinesPreview",
    bundle_id="md.redlines.editor.preview",
    title="Redlines Quick Look",
    point="com.apple.quicklook.preview",
    principal="RedlinesPreviewProvider",
    script="preview.js",
    sources=("PreviewRenderer.swift", "extension/PreviewProvider.swift"),
    frameworks=("QuickLookUI", "JavaScriptCore"),
    entitlements=SWIFT / "RedlinesPreview.entitlements",
    # JavaScriptCore's compiler is all it asks for besides the sandbox (swift/RedlinesPreview.entitlements).
    granted=("com.apple.security.app-sandbox", "com.apple.security.cs.allow-jit"),
    # A data-based preview: the extension answers with a page of HTML.
    attributes={"QLIsDataBasedPreview": True, "QLSupportsSearchableItems": False},
)
THUMBNAIL = Extension(
    name="RedlinesThumbnail",
    bundle_id="md.redlines.editor.thumbnail",
    title="Redlines Thumbnails",
    point="com.apple.quicklook.thumbnail",
    principal="RedlinesThumbnailProvider",
    script="thumbnail.js",
    sources=("PreviewRenderer.swift", "ThumbnailPage.swift", "thumbnail/ThumbnailProvider.swift"),
    frameworks=("QuickLookThumbnailing", "JavaScriptCore", "AppKit"),
    entitlements=SWIFT / "RedlinesThumbnail.entitlements",
    # The sandbox, and nothing else: no compiler, since a thumbnail reads 64 KB (swift/RedlinesThumbnail.entitlements).
    granted=("com.apple.security.app-sandbox",),
    attributes={"QLThumbnailMinimumDimension": 16},
    fonts=True,
)
EXTENSIONS = [PREVIEW, THUMBNAIL]


def quick_look_types() -> List[str]:
    """The types that both extensions list: what macOS asks each extension for."""
    return MARKDOWN_TYPES + [dynamic_type(extension) for extension in EXTENSIONS_WITH_NO_TYPE]


def fail(message: str) -> NoReturn:
    sys.exit(f"build-quicklook: {message}")


def run(*command: object, cwd: Optional[Path] = None) -> None:
    words = [str(word) for word in command]
    try:
        subprocess.run(words, cwd=cwd, check=True)
    except FileNotFoundError:
        fail(f"{words[0]} isn't on the PATH.")
    except subprocess.CalledProcessError as error:
        fail(f"{' '.join(words[:2])} failed, with the exit code {error.returncode}.")


def output(*command: object, check: bool = True) -> str:
    """What a command prints, standard error too (codesign writes there)."""
    words = [str(word) for word in command]
    try:
        done = subprocess.run(words, check=False, capture_output=True, text=True)
    except FileNotFoundError:
        fail(f"{words[0]} isn't on the PATH.")
    if check and done.returncode != 0:
        fail(f"{' '.join(words[:2])} failed, with the exit code {done.returncode}:\n{done.stdout}{done.stderr}")
    return done.stdout + done.stderr


# ---- The types the extension previews -------------------------------------------------------------

_ALPHABET = "abcdefghkmnpqrstuvwxyz0123456789"
# The first 61 bits of the dynamic type of every filename extension. macOS makes the type of a file
# whose extension no one declares from the extension alone: "dyn." and then the base 32 (this
# alphabet) of 61 fixed bits, the extension's letters in lower case, one byte each, and zeros to fill
# the last digit. Quick Look matches an extension's QLSupportedContentTypes against that exact type,
# so a type that no one has declared can be listed by the extension, which is how R Markdown and
# Quarto are previewed without declaring a type that would compete with another app's for them.
_DYNAMIC_HEAD = "0000000111111001100000011110100110110001110100011000100111101"
# Made by macOS 27.0.1 for extensions that nothing declares (`preview-render --dynamic-type`).
_DYNAMIC_KNOWN = {
    "zq": "dyn.ah62d4rv4ge81y6k",
    "zqa": "dyn.ah62d4rv4ge81y6pb",
    "zqmd": "dyn.ah62d4rv4ge81y6prqu",
    "zzqmd2": "dyn.ah62d4rv4ge81y8xvrzwde",
}


def dynamic_type(extension: str) -> str:
    """The type macOS gives a file with this extension when nothing declares it."""
    bits = _DYNAMIC_HEAD + "".join(format(byte, "08b") for byte in extension.lower().encode("ascii"))
    bits += "0" * (-len(bits) % 5)
    return "dyn." + "".join(_ALPHABET[int(bits[i : i + 5], 2)] for i in range(0, len(bits), 5))


for _extension, _type in _DYNAMIC_KNOWN.items():
    assert dynamic_type(_extension) == _type, f"the dynamic type of .{_extension} isn't {_type}"


# ---- Building ------------------------------------------------------------------------------------


def app_version() -> str:
    """The app's version, which is written in src-tauri/Cargo.toml alone."""
    text = CARGO_TOML.read_text(encoding="utf-8")
    package = re.search(r"^\[package\]\s*$(.*?)(?=^\[|\Z)", text, re.S | re.M)
    found = re.search(r'^version\s*=\s*"([^"]+)"', package.group(1) if package else "", re.M)
    if not found:
        fail(f"{CARGO_TOML} has no version.")
    return found.group(1)


def sdk_path() -> str:
    return output("xcrun", "--sdk", "macosx", "--show-sdk-path").strip()


def bundle_scripts() -> None:
    """The scripts that the extensions run, each as one script for JavaScriptCore: the `bundle` script of
    quicklook, without pnpm."""
    if not ROLLDOWN.exists():
        fail(f"{ROLLDOWN} isn't there. Run pnpm install at the root of the repository.")
    for config in ("rolldown.config.mjs", "rolldown.thumbnail.config.mjs"):
        run(ROLLDOWN, "-c", config, cwd=QUICKLOOK)
    for extension in EXTENSIONS:
        script = BUILD / extension.script
        if not script.exists():
            fail(f"{script} wasn't written.")


def swiftc(arch: str, sources: List[Path], out: Path, *flags: str) -> None:
    run(
        "swiftc",
        "-target", f"{arch}-apple-macos{MINIMUM_MACOS}",
        "-sdk", sdk_path(),
        "-swift-version", "5",
        "-O",
        *flags,
        *sources,
        "-o", out,
    )  # fmt: skip


def info_plist(extension: Extension) -> dict:
    version = app_version()
    return {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleDisplayName": extension.title,
        "CFBundleExecutable": extension.name,
        "CFBundleIdentifier": extension.bundle_id,
        "CFBundleInfoDictionaryVersion": "6.0",
        "CFBundleName": extension.title,
        "CFBundlePackageType": "XPC!",
        "CFBundleShortVersionString": version,
        "CFBundleVersion": version,
        "LSMinimumSystemVersion": MINIMUM_MACOS,
        "NSExtension": {
            "NSExtensionAttributes": {
                **extension.attributes,
                "QLSupportedContentTypes": quick_look_types(),
            },
            "NSExtensionPointIdentifier": extension.point,
            "NSExtensionPrincipalClass": extension.principal,
        },
    }


def sign(extension: Extension, identity: Optional[str]) -> None:
    """Signs the extension, with the sandbox entitlement and the hardened runtime. With a Developer
    ID it also asks for a secure timestamp, which notarization requires; ad hoc has none."""
    identity = identity or "-"
    command = ["codesign", "--force", "--sign", identity, "--options", "runtime"]
    command += ["--entitlements", str(extension.entitlements)]
    if identity != "-":
        command.append("--timestamp")
    run(*command, extension.appex)
    print(f"build-quicklook: signed {extension.appex.name} ({'ad hoc' if identity == '-' else 'with the identity'})", flush=True)


def copy_fonts(into: Path) -> None:
    """The theme's font files, for the extension that draws text itself."""
    into.mkdir(parents=True)
    for family, files in FONT_FILES.items():
        for file in files:
            source = QUICKLOOK / "node_modules" / "@fontsource" / family / "files" / file
            if not source.exists():
                fail(f"{source} isn't there. Run pnpm install at the root of the repository.")
            shutil.copy(source, into / file)


def build_extension(extension: Extension, identity: Optional[str]) -> None:
    if extension.appex.exists():
        shutil.rmtree(extension.appex)
    contents = extension.appex / "Contents"
    (contents / "MacOS").mkdir(parents=True)
    (contents / "Resources").mkdir()
    frameworks = [flag for framework in extension.frameworks for flag in ("-framework", framework)]
    parts = []
    for arch in ARCHS:
        part = BUILD / f"{extension.name}-{arch}"
        swiftc(
            arch,
            [SWIFT / source for source in extension.sources],
            part,
            "-module-name", extension.name,
            "-application-extension",
            "-parse-as-library",
            "-Xlinker", "-e", "-Xlinker", "_NSExtensionMain",
            *frameworks,
        )  # fmt: skip
        parts.append(part)
    run("lipo", "-create", "-output", contents / "MacOS" / extension.name, *parts)
    for part in parts:
        part.unlink()
    shutil.copy(BUILD / extension.script, contents / "Resources" / extension.script)
    if extension.fonts:
        copy_fonts(contents / "Resources" / "fonts")
    with open(contents / "Info.plist", "wb") as plist:
        plistlib.dump(info_plist(extension), plist)
    sign(extension, identity)
    print(f"build-quicklook: {extension.appex}", flush=True)


def build(identity: Optional[str]) -> None:
    bundle_scripts()
    for extension in EXTENSIONS:
        build_extension(extension, identity)


def build_harness() -> None:
    """`preview-render`, which runs the scripts and draws the thumbnails as the extensions do, for this
    machine's processor."""
    arch = "arm64" if platform.machine() == "arm64" else "x86_64"
    swiftc(
        arch,
        [SWIFT / "PreviewRenderer.swift", SWIFT / "ThumbnailPage.swift", SWIFT / "harness" / "main.swift"],
        HARNESS,
        "-framework", "JavaScriptCore",
        "-framework", "UniformTypeIdentifiers",
        "-framework", "AppKit",
    )  # fmt: skip
    # With the hardened runtime and the compiler, as the preview has them: without the entitlement
    # the renderer takes several times as long, and the harness would time something else.
    run("codesign", "--force", "--sign", "-", "--options", "runtime", "--entitlements", HARNESS_ENTITLEMENTS, HARNESS)


# ---- Checks --------------------------------------------------------------------------------------


class Checks:
    def __init__(self) -> None:
        self.failed = 0

    def ok(self, condition: bool, what: str, detail: str = "") -> None:
        if condition:
            print(f"  ok   {what}", flush=True)
        else:
            self.failed += 1
            print(f"  FAIL {what}{': ' + detail if detail else ''}", flush=True)

    def done(self) -> None:
        if self.failed:
            fail(f"{self.failed} check{'s' if self.failed != 1 else ''} failed.")
        print("build-quicklook: all checks passed.", flush=True)


def architectures(binary: Path) -> List[str]:
    return output("lipo", "-archs", binary).split()


def display(path: Path) -> str:
    """What `codesign --display` says of a signed bundle: its signature, verbosely, and its entitlements
    as XML. macOS 27 warns that the form with a colon (`:-`) will stop working, so the one with `--xml`
    goes first, and the colon form is for a codesign that doesn't know `--xml`."""
    shown = output("codesign", "--display", "--verbose=2", "--entitlements", "-", "--xml", path, check=False)
    if "<plist" not in shown:
        shown = output("codesign", "--display", "--verbose=2", "--entitlements", ":-", path, check=False)
    return shown


def check_layout(extension: Extension, appex: Path, checks: Checks, signed: bool) -> None:
    """The extension's files, its Info.plist, its architectures, its entitlements and its signature."""
    name = appex.name
    binary = appex / "Contents" / "MacOS" / extension.name
    resources = appex / "Contents" / "Resources"
    checks.ok(binary.is_file(), f"{name} has its program")
    checks.ok((resources / extension.script).is_file(), f"{name} has its script")
    if extension.fonts:
        for file in [file for files in FONT_FILES.values() for file in files]:
            checks.ok((resources / "fonts" / file).is_file(), f"{name} has the font {file}")
    if not binary.is_file():
        return
    both = sorted(architectures(binary)) == sorted(ARCHS)
    checks.ok(both, f"{name} runs on Apple silicon and Intel", " ".join(architectures(binary)))
    with open(appex / "Contents" / "Info.plist", "rb") as handle:
        info = plistlib.load(handle)
    declared = info.get("NSExtension", {})
    attributes = declared.get("NSExtensionAttributes", {})
    checks.ok(declared.get("NSExtensionPointIdentifier") == extension.point, f"{name} is for {extension.point}")
    checks.ok(declared.get("NSExtensionPrincipalClass") == extension.principal, f"{name} has its principal class")
    for key, value in extension.attributes.items():
        checks.ok(attributes.get(key) == value, f"{name} has {key} {value!r}", str(attributes.get(key)))
    checks.ok(attributes.get("QLSupportedContentTypes") == quick_look_types(), f"{name} lists its types", str(attributes.get("QLSupportedContentTypes")))
    checks.ok(info.get("CFBundleIdentifier") == extension.bundle_id, f"{name} has its identifier")
    checks.ok(info.get("LSMinimumSystemVersion") == MINIMUM_MACOS, f"{name} asks for macOS {MINIMUM_MACOS}")
    for arch in ARCHS:
        said = output("vtool", "-arch", arch, "-show-build", binary, check=False)
        found = re.search(r"minos (\S+)", said)
        checks.ok(found is not None and found.group(1) == MINIMUM_MACOS, f"{name} is built for macOS {MINIMUM_MACOS} ({arch})", said.strip().splitlines()[-1] if said.strip() else "")
    verified = subprocess.run(["codesign", "--verify", "--strict", "--verbose=2", appex], capture_output=True, text=True)
    checks.ok(verified.returncode == 0, f"{name}'s signature holds", verified.stderr.strip())
    shown = display(appex)
    checks.ok("<key>com.apple.security.app-sandbox</key>" in shown, f"{name} is sandboxed")
    checks.ok("com.apple.security.network" not in shown, f"{name} has no network")
    # Only the entitlements that its file names (swift/*.entitlements): the sandbox, and for the
    # preview JavaScriptCore's compiler.
    granted = re.findall(r"<key>(com\.apple\.[^<]+)</key>", shown)
    checks.ok(sorted(granted) == sorted(extension.granted), f"{name} has {' and '.join(g.rsplit('.', 1)[-1] for g in extension.granted)}, and no other entitlement", str(granted))
    checks.ok(re.search(r"flags=0x[0-9a-f]+\([^)]*\bruntime\b", shown) is not None, f"{name} has the hardened runtime")
    if signed:
        checks.ok("Authority=Developer ID Application" in shown, f"{name} is signed with a Developer ID")
        checks.ok("Timestamp=" in shown, f"{name} has a secure timestamp")


def fixture_checks(checks: Checks) -> None:
    """Renders each fixture in JavaScriptCore, as the extension does, and reads the page."""
    script = BUILD / "preview.js"

    def render(path: Path, *flags: str) -> str:
        done = subprocess.run([HARNESS, script, path, *flags], capture_output=True, text=True)
        if done.returncode != 0:
            checks.ok(False, f"{path.name} renders", done.stderr.strip())
            return ""
        print(f"       {done.stderr.strip()}", flush=True)
        return done.stdout

    def has(html: str, label: str, *wanted: str) -> None:
        for text in wanted:
            checks.ok(text in html, f"{label} has {text[:60]!r}")

    def lacks(html: str, label: str, *unwanted: str) -> None:
        for text in unwanted:
            checks.ok(text not in html, f"{label} has no {text[:60]!r}")

    page = render(FIXTURES / "plain.md")
    has(page, "plain.md", "<h1>Field notes</h1>", "<em>plain</em>", "<del>struck</del>", '<input type="checkbox" disabled="" checked="" />', 'class="rl-image">A red caret on warm paper<', "&lt;script&gt;alert", "<hr />")
    lacks(page, "plain.md", "<script", "<img", "only the author sees", 'class="rl-notice"', "<!--")

    page = render(FIXTURES / "redlines.md")
    has(page, "redlines.md", "3 changes and 1 comment by Ada Lovelace, Claude and Bo Chen. Open in Redlines to review them.", "We will ship the new importer in April, after the security review.")
    lacks(page, "redlines.md", "March", "The old exporter", "k3x9", "Who signs off", "<!--")

    page = render(FIXTURES / "frontmatter.qmd")
    has(page, "frontmatter.qmd", '<pre class="rl-frontmatter">---', "title: &quot;Penguin bills&quot;", 'data-chunk="r setup, include=FALSE"', 'data-chunk="python"', "#| label: fig-bills")
    page = render(FIXTURES / "analysis.Rmd")
    has(page, "analysis.Rmd", 'data-chunk="r, echo=FALSE, message=FALSE"', "<h1>Summary</h1>")

    page = render(FIXTURES / "table.md")
    has(page, "table.md", '<div class="rl-tbl-scroll"><table>', '<th align="right">Runs</th>', '<th align="center">Mean (ms)</th>', "<strong>Faster</strong>")

    # What the extension shows when the renderer fails: the file's text, as text.
    plain = FIXTURES / "plain.md"
    done = subprocess.run([HARNESS, "--fallback", plain], capture_output=True, text=True)
    has(done.stdout, "the fallback page", "&lt;script&gt;alert('no')&lt;/script&gt;", "# Field notes", "default-src 'none'")
    lacks(done.stdout, "the fallback page", "<script", "<img", "<h1>")

    # How the extension reads a file (PreviewText in swift/PreviewRenderer.swift): a byte order mark
    # isn't text, bytes that aren't UTF-8 are the replacement character, and a file longer than the
    # extension reads is drawn as far as that, says so, and names nobody, since its ledger isn't read.
    BUILD.mkdir(exist_ok=True)
    odd = BUILD / "odd.md"
    odd.write_bytes(b"\xef\xbb\xbf# With a mark\n")
    has(render(odd), "a file with a byte order mark", "<h1>With a mark</h1>")
    odd.write_bytes(b"# Caf\xe9\n\nBytes that are not UTF-8.\n")
    has(render(odd), "a file that is not UTF-8", "<h1>Caf\ufffd</h1>")
    odd.unlink()
    over = BUILD / "over.md"
    ledger_after = (
        "<!-- redlines\nversion: 1\npeople:\n  ada: {name: Ada}\n"
        "marks:\n  k3x9: {by: ada, at: 2026-10-13T22:30Z}\ncomments: []\n-->\n"
    )
    over.write_text("# Over the limit\n\nA <!--ins k3x9-->new <!--/k3x9-->word.\n\n" + "A paragraph of text.\n\n" * 220000 + ledger_after, encoding="utf-8")
    page = render(over)
    has(page, "a file over the extension's limit", "<h1>Over the limit</h1>", "first part of a long document")
    lacks(page, "a file over the extension's limit", '<p class="rl-notice">')
    over.unlink()

    # A large file: about 2 MB, with a change at the top and the ledger at the end.
    BUILD.mkdir(exist_ok=True)
    large = BUILD / "large.md"
    section = (
        "## A section\n\n"
        "Paragraph with *emphasis*, **strong** text, `code` and a [link](https://example.com/page). "
        "It goes on for a while so that the file is long, as a book's chapters are. " * 2
        + "\n\n- one\n- two\n- three\n\n| a | b |\n| - | - |\n| 1 | 2 |\n\n"
    )
    ledger = (
        "\n<!-- redlines\nversion: 1\npeople:\n  ada: {name: Ada Lovelace}\n"
        "marks:\n  k3x9: {by: ada, at: 2026-10-13T22:30Z}\ncomments: []\n-->\n"
    )
    body = "# A long document\n\nIt starts with a <!--ins k3x9-->new <!--/k3x9-->word.\n\n" + section * 4000
    large.write_text(body + ledger, encoding="utf-8")
    started = time.monotonic()
    page = render(large)
    seconds = time.monotonic() - started
    has(page, "large.md", "<h1>A long document</h1>", "first part of a long document")
    # With JavaScriptCore's compiler this takes a second or two. Without it (a runner that denies it,
    # or Lockdown Mode) it takes several times that, which this lets by: what it is after is a render
    # that never ends, since Quick Look gives an extension no more than a little while.
    checks.ok(seconds < 30, f"large.md ({large.stat().st_size // 1024} KB) renders in under 30 s", f"{seconds:.1f} s")
    large.unlink()


def thumbnail_checks(checks: Checks) -> None:
    """Draws the thumbnail of each fixture as the extension does, from the extension's own script and
    fonts, and reads what it drew: the blocks of the Clean view, and a picture of the page."""
    script = BUILD / THUMBNAIL.script
    fonts = THUMBNAIL.appex / "Contents" / "Resources" / "fonts"
    pictures = BUILD / "thumbnails"
    pictures.mkdir(exist_ok=True)

    def blocks(path: Path) -> str:
        done = subprocess.run([HARNESS, "--blocks", script, path], capture_output=True, text=True)
        if done.returncode != 0:
            checks.ok(False, f"{path.name} gives its blocks", done.stderr.strip())
        return done.stdout

    def has(text: str, label: str, *wanted: str) -> None:
        for each in wanted:
            checks.ok(each in text, f"{label} has {each[:60]!r}")

    def lacks(text: str, label: str, *unwanted: str) -> None:
        for each in unwanted:
            checks.ok(each not in text, f"{label} has no {each[:60]!r}")

    page = blocks(FIXTURES / "plain.md")
    has(page, "the blocks of plain.md", '{"kind":"heading","level":1,"text":"Field notes"}', '"kind":"item"', '"kind":"quote"', '"kind":"code"', '"kind":"rule"')
    lacks(page, "the blocks of plain.md", "only the author sees", "<!--", "**")
    page = blocks(FIXTURES / "redlines.md")
    has(page, "the blocks of redlines.md", "We will ship the new importer in April, after the security review.", "A second paragraph")
    lacks(page, "the blocks of redlines.md", "March", "The old exporter", "k3x9", "Who signs off", "version", "<!--")
    page = blocks(FIXTURES / "frontmatter.qmd")
    has(page, "the blocks of frontmatter.qmd", '"text":"Setup"', "library(palmerpenguins)")
    lacks(page, "the blocks of frontmatter.qmd", "Penguin bills", "include=FALSE")
    page = blocks(FIXTURES / "table.md")
    has(page, "the blocks of table.md", '"kind":"table"', '"Baseline"')

    # A file with nothing in it but its ledger has no blocks: no thumbnail, and the icon stays.
    empty = BUILD / "empty.md"
    empty.write_text("<!-- redlines\nversion: 1\npeople: {}\nmarks: {}\ncomments: []\n-->\n", encoding="utf-8")
    checks.ok(blocks(empty).strip() == "[]", "a file with only a ledger has no blocks")
    empty.unlink()

    # A picture of each page: it holds text, and is not all ink.
    for fixture in ["plain.md", "redlines.md", "table.md", "frontmatter.qmd", "analysis.Rmd"]:
        out = pictures / f"{fixture}.png"
        done = subprocess.run([HARNESS, "--thumbnail", script, fonts, FIXTURES / fixture, out, "--width", "256"], capture_output=True, text=True)
        found = re.search(r"thumbnail (\d+)x(\d+), (\d+) blocks .*, ink ([0-9.]+), in (\d+) ms", done.stdout)
        checks.ok(done.returncode == 0 and found is not None, f"{fixture} has a thumbnail", (done.stderr or done.stdout).strip())
        if found is not None:
            print(f"       {done.stdout.strip()}", flush=True)
            checks.ok(0.002 < float(found.group(4)) < 0.6, f"the thumbnail of {fixture} holds text, and is not all ink", f"ink {found.group(4)}")
            checks.ok(out.is_file() and out.stat().st_size > 1000, f"the thumbnail of {fixture} is a picture")

    # A large file gives its thumbnail as fast as a small one: a thumbnail reads the start of a file.
    large = BUILD / "large-thumbnail.md"
    large.write_text("# A long document\n\n" + "## A section\n\nA paragraph of text, which goes on for a while.\n\n- one\n- two\n\n" * 40000, encoding="utf-8")
    started = time.monotonic()
    done = subprocess.run([HARNESS, "--thumbnail", script, fonts, large, pictures / "large.png", "--width", "256"], capture_output=True, text=True)
    seconds = time.monotonic() - started
    checks.ok(done.returncode == 0 and seconds < 5, f"the thumbnail of a large file ({large.stat().st_size // 1024} KB) takes under 5 s", f"{seconds:.1f} s; {done.stderr.strip()}")
    large.unlink()


def check() -> None:
    checks = Checks()
    for extension in EXTENSIONS:
        print(f"build-quicklook: {extension.name}", flush=True)
        check_layout(extension, extension.appex, checks, signed=False)
    build_harness()
    # The dynamic types: the formula above gives what this Mac gives, for an extension nobody declares.
    asked = subprocess.run([HARNESS, "--dynamic-type", "zzqmdx"], capture_output=True, text=True).stdout.strip()
    checks.ok(asked == dynamic_type("zzqmdx"), "the dynamic types are the Mac's", f"{asked} vs {dynamic_type('zzqmdx')}")
    print("build-quicklook: the renderer in JavaScriptCore", flush=True)
    fixture_checks(checks)
    print("build-quicklook: the thumbnails", flush=True)
    thumbnail_checks(checks)
    checks.done()


def check_app(app: Path, signed: bool) -> None:
    checks = Checks()
    print(f"build-quicklook: {app}", flush=True)
    found = []
    for extension in EXTENSIONS:
        appex = app / "Contents" / extension.in_app
        checks.ok(appex.is_dir(), f"the app has {extension.in_app}")
        if appex.is_dir():
            check_layout(extension, appex, checks, signed=signed)
            found.append(appex)
    if found and signed:
        # The app's own seal covers the extensions: a change inside one breaks the app's signature.
        verified = subprocess.run(["codesign", "--verify", "--deep", "--strict", "--verbose=2", app], capture_output=True, text=True)
        checks.ok(verified.returncode == 0, "the app's signature holds with the extensions inside", verified.stderr.strip())

        # All are signed by the same team: an extension of another team's, or none, isn't loaded.
        def team(path: Path) -> str:
            found = re.search(r"TeamIdentifier=([A-Z0-9]{10})\b", output("codesign", "--display", "--verbose=2", path, check=False))
            return found.group(1) if found else ""

        for appex in found:
            checks.ok(team(appex) != "" and team(appex) == team(app), f"{appex.name} and the app are of one team", f"{team(appex)!r} and {team(app)!r}")
    checks.done()


def main() -> None:
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__)
        return
    if sys.platform != "darwin":
        print("build-quicklook: skipped; the Quick Look extensions are for the Mac app.", flush=True)
        return
    identity = None
    if "--check-app" in args:
        i = args.index("--check-app")
        if i + 1 >= len(args):
            fail("--check-app needs the app's path.")
        check_app(Path(args[i + 1]), signed="--signed" in args)
        return
    import os

    identity = os.environ.get("APPLE_SIGNING_IDENTITY") or None
    for extension in EXTENSIONS if ("--sign-only" in args or "--check-only" in args) else []:
        if not extension.appex.exists():
            fail(f"{extension.appex} isn't there. Run scripts/build-quicklook first.")
    if "--sign-only" in args:
        if identity is None:
            fail("--sign-only needs APPLE_SIGNING_IDENTITY.")
        for extension in EXTENSIONS:
            sign(extension, identity)
        return
    if "--check-only" in args:
        check()
        return
    build(identity)
    if "--check" in args:
        check()


if __name__ == "__main__":
    main()
