#!/usr/bin/env python3
"""Runs a built Redlines.app and screenshots each of its windows, by window id.

The page's own screenshots (the journeys, apps/desktop/journeys) never show what the app draws
around the page: the title bar, the window's shadow, Preferences, About, a dialog, the menu bar's
effect on the window. This does: it starts the app's program, finds its windows by process id and
takes each with `screencapture -l<window id>`, which captures that window alone, whatever is in
front of it.

    scripts/app-windows [--app PATH] [--debug] [--out DIR] [--file DOC.md] [--panes] [--wait SECONDS]

    --app PATH   the app to run (default: src-tauri/target/release/bundle/macos/Redlines.app)
    --debug      the debug build's app, src-tauri/target/debug/bundle/macos/Redlines.app
    --out DIR    where the PNG files and index.md go (default: apps/desktop/app-windows/)
    --file DOC   a document to open at launch (default: none: the app's own new document)
    --panes      also opens Preferences and About with the menu's keys, and takes those (needs the
                 Accessibility permission for the terminal; without it they are skipped, said so)
    --wait N     seconds to let the app draw before each shot (default 4)

The terminal needs Screen Recording permission, which Stephan grants once: System Settings ›
Privacy & Security › Screen & System Audio Recording, then the terminal (or the Claude app that runs
it) on the list, then quit and open it again. Without it `screencapture` writes the wallpaper, not
the window, so this stops first and says so. It never asks for computer use. Only the program it
started is ever stopped.

Run it in apps/desktop (Python 3, macOS, and `swiftc` from the Xcode command line tools).
"""

from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
DESKTOP = HERE.parent
HELPER_SOURCE = HERE / "window-list.swift"


def fail(message: str) -> "None":
    print(f"app-windows: {message}", file=sys.stderr)
    sys.exit(1)


def build_helper(cache: Path) -> Path:
    """Compiles window-list.swift once (and again when it changes)."""
    cache.mkdir(parents=True, exist_ok=True)
    helper = cache / "window-list"
    if not helper.exists() or helper.stat().st_mtime < HELPER_SOURCE.stat().st_mtime:
        done = subprocess.run(
            ["swiftc", "-O", str(HELPER_SOURCE), "-o", str(helper)], capture_output=True, text=True
        )
        if done.returncode != 0:
            fail(f"could not compile window-list.swift (Xcode command line tools?):\n{done.stderr}")
    return helper


def program_of(app: Path) -> Path:
    with open(app / "Contents" / "Info.plist", "rb") as f:
        name = plistlib.load(f)["CFBundleExecutable"]
    return app / "Contents" / "MacOS" / name


def windows_of(helper: Path, pids: list[int]) -> list[dict]:
    done = subprocess.run([str(helper), *map(str, pids)], capture_output=True, text=True)
    if done.returncode != 0:
        fail(f"window-list failed: {done.stderr}")
    return json.loads(done.stdout)


def children_of(pid: int) -> list[int]:
    """The process and its children: the app's windows may belong to a helper process."""
    done = subprocess.run(["pgrep", "-P", str(pid)], capture_output=True, text=True)
    return [pid, *(int(p) for p in done.stdout.split())]


def real_windows(windows: list[dict]) -> list[dict]:
    """The windows a person sees: layer 0, on screen, and larger than a stray 1-pixel helper."""
    return [w for w in windows if w["layer"] == 0 and w["onscreen"] and w["width"] > 100]


def slug(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "window"


def keystroke(keys: str) -> bool:
    """Types a menu key into the frontmost app, through System Events (needs Accessibility)."""
    done = subprocess.run(
        ["osascript", "-e", f'tell application "System Events" to {keys}'],
        capture_output=True,
        text=True,
    )
    if done.returncode != 0:
        print(f"app-windows: skipped, System Events refused: {done.stderr.strip()}", file=sys.stderr)
    return done.returncode == 0


def main() -> None:
    parser = argparse.ArgumentParser(description="Screenshots the windows of a built Redlines.app.")
    parser.add_argument("--app", type=Path)
    parser.add_argument("--debug", action="store_true")
    parser.add_argument("--out", type=Path, default=DESKTOP / "app-windows")
    parser.add_argument("--file", type=Path)
    parser.add_argument("--panes", action="store_true")
    parser.add_argument("--wait", type=float, default=4.0)
    args = parser.parse_args()

    if sys.platform != "darwin":
        fail("this runs on a Mac")
    profile = "debug" if args.debug else "release"
    app = args.app or DESKTOP / "src-tauri" / "target" / profile / "bundle" / "macos" / "Redlines.app"
    if not app.is_dir():
        fail(f"{app} is not there; build it with `pnpm tauri build --bundles app` in apps/desktop")

    helper = build_helper(args.out / ".tools")
    if subprocess.run([str(helper), "--preflight"], capture_output=True).returncode != 0:
        fail(
            "the terminal may not record the screen. Grant it in System Settings › Privacy & "
            "Security › Screen & System Audio Recording, then quit and open the terminal again."
        )

    args.out.mkdir(parents=True, exist_ok=True)
    for old in args.out.glob("*.png"):
        old.unlink()

    program = program_of(app)

    def running() -> set[int]:
        done = subprocess.run(["pgrep", "-f", f"^{re.escape(str(program))}"], capture_output=True, text=True)
        return {int(p) for p in done.stdout.split()}

    # Through Launch Services, as a double-click starts it (a new instance, so that one the person
    # has open is never the one stopped): the process that appears is the one this started.
    before = running()
    command = ["open", "-n", "-a", str(app)]
    if args.file:
        command += ["--args", str(args.file.resolve())]
    subprocess.run(command, check=True)
    started = None
    for _ in range(120):
        new = running() - before
        if new:
            started = min(new)
            break
        time.sleep(0.25)
    if started is None:
        fail("the app did not start")
    taken: list[tuple[str, dict]] = []
    seen: set[int] = set()

    def shoot(label: str) -> None:
        pids = children_of(started)
        for w in real_windows(windows_of(helper, pids)):
            if w["id"] in seen:
                continue
            seen.add(w["id"])
            name = f"{len(taken) + 1:02d}-{label}-{slug(w['title'])}.png"
            # -o: no shadow, -x: no sound; the window alone, whatever is in front of it.
            done = subprocess.run(["screencapture", "-x", "-o", f"-l{w['id']}", str(args.out / name)])
            if done.returncode == 0:
                taken.append((name, w))

    try:
        deadline = time.time() + 60
        while time.time() < deadline and not real_windows(windows_of(helper, children_of(started))):
            if started not in running():
                fail("the app quit at launch")
            time.sleep(0.5)
        time.sleep(args.wait)
        shoot("main")
        if args.panes:
            for label, keys in (
                ("preferences", 'keystroke "," using command down'),
            ):
                if keystroke(keys):
                    time.sleep(args.wait)
                    shoot(label)
    finally:
        # Only the process this started: asked to quit, and killed if it ignores the request.
        if started in running():
            os.kill(started, signal.SIGTERM)
            for _ in range(40):
                if started not in running():
                    break
                time.sleep(0.25)
            else:
                os.kill(started, signal.SIGKILL)

    lines = ["# The app's windows", "", f"App: `{app}`", ""]
    for name, w in taken:
        lines.append(f"- `{name}`: {w['owner']} “{w['title']}”, {int(w['width'])}×{int(w['height'])}")
    (args.out / "index.md").write_text("\n".join(lines) + "\n")
    print("\n".join(lines))
    if not taken:
        fail("no window was found")


if __name__ == "__main__":
    main()
