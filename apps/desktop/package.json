{
  "name": "@redlines/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The Redlines desktop app, built with Tauri v2.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "scripts/build-redlines && pnpm run typecheck && vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@redlines/agent-acp": "workspace:*",
    "@redlines/agent-claude": "workspace:*",
    "@redlines/agent-codex": "workspace:*",
    "@redlines/agents": "workspace:*",
    "@redlines/code": "workspace:*",
    "@redlines/editor": "workspace:*",
    "@redlines/find": "workspace:*",
    "@redlines/format": "workspace:*",
    "@redlines/plugin-api": "workspace:*",
    "@redlines/review": "workspace:*",
    "@redlines/themes": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "redlines": "workspace:*",
    "vite": "^8.3.4"
  }
}
