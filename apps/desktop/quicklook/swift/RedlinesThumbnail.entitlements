<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the Finder thumbnail extension may do: only what an app extension must, the sandbox, which
  lets it read the one file that Finder hands it. No network, so that a thumbnail never tells anyone
  that a file was seen, and not JavaScriptCore's compiler either (the preview's allow-jit): a
  thumbnail reads the first 64 KB of a file and scans them for the blocks of a page, which the
  interpreter does in a few milliseconds.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
</dict>
</plist>
