<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The command line that tests the extension (scripts/build-quicklook) runs the renderer as the extension does: with JavaScriptCore's compiler, which the extension's entitlements allow. It is not sandboxed, since it reads the fixtures. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
