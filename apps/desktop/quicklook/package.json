{
  "name": "@redlines/quicklook",
  "version": "0.0.0",
  "private": true,
  "description": "The Quick Look preview of Markdown files in the Mac app: the renderer, which runs in JavaScriptCore, and the Swift extension that hosts it. Not an API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bundle": "rolldown -c rolldown.config.mjs && rolldown -c rolldown.thumbnail.config.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@redlines/format": "workspace:*",
    "@redlines/themes": "workspace:*",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "micromark-util-types": "2.0.3",
    "rolldown": "1.2.14"
  }
}
