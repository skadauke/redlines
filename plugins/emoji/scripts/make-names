#!/usr/bin/env python3
"""Writes src/names.ts, the emoji and their shortcodes, from github/gemoji's db/emoji.json.

    scripts/make-names path/to/emoji.json [revision]

gemoji (https://github.com/github/gemoji, MIT, Copyright (c) 2019 GitHub, Inc.) is the list GitHub
uses for its shortcodes. The file written has one emoji per line, then every name GitHub gives it, in
the order of gemoji's list. Run it again when gemoji's list changes, and commit the result.
"""

import json
import re
import sys
from pathlib import Path

NAME = re.compile(r"^[a-z0-9_+-]+$")


def main() -> None:
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    revision = sys.argv[2] if len(sys.argv) > 2 else "unknown"
    entries = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    lines = []
    names = set()
    for entry in entries:
        aliases = entry.get("aliases", [])
        # The emoji is the one with no white space; a name has none either, so a space parts them.
        if "emoji" not in entry or not aliases:
            continue
        for name in aliases:
            if not NAME.match(name) or name in names:
                sys.exit(f"unexpected or repeated name: {name!r}")
            names.add(name)
        lines.append(entry["emoji"] + " " + " ".join(aliases))
    assert "`" not in "".join(lines) and "${" not in "".join(lines) and "\\" not in "".join(lines)
    out = Path(__file__).resolve().parent.parent / "src" / "names.ts"
    notice = (Path(__file__).resolve().parent.parent / "NOTICE").read_text(encoding="utf-8")
    # The license is a legal comment (`/*! … */`), which a bundler keeps in what it writes.
    legal = (
        "/*! Names and emoji from github/gemoji (https://github.com/github/gemoji), db/emoji.json, revision "
        + revision
        + ".\n"
        + notice.replace("*/", "* /").rstrip("\n")
        + "\n*/\n"
    )
    out.write_text(
        legal
        + "// Generated by scripts/make-names. Do not edit by hand.\n"
        "// One emoji per line, then the names GitHub gives it, in the order of gemoji's list.\n"
        "export const GEMOJI = `"
        + "\n".join(lines)
        + "\n`;\n",
        encoding="utf-8",
    )
    print(f"{len(lines)} emoji, {len(names)} names -> {out}")


main()
