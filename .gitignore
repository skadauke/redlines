node_modules/
.DS_Store
website/.next/
website/out/

# Build output
dist/
coverage/
target/
*.tsbuildinfo

# Generated by tauri-build on every compile
apps/desktop/src-tauri/gen/schemas/
# The permission of each app command, written by tauri-build from the list in build.rs
apps/desktop/src-tauri/permissions/

# The redlines program and its bundled script (apps/desktop/scripts/build-redlines)
apps/desktop/src-tauri/binaries/
apps/desktop/redlines/bundle/

# The Quick Look extension and its renderer's bundle (apps/desktop/scripts/build-quicklook)
apps/desktop/quicklook/build/

# Vitest output a reporter or a crashed run can leave behind.
.vitest/

# What a journeys run leaves behind (apps/desktop/journeys): the report, the traces and the
# screenshots of the run.
apps/desktop/journeys/test-results/
apps/desktop/journeys/playwright-report/
# The pictures collected for a look review (apps/desktop/journeys/scripts/look-review.ts)
apps/desktop/journeys/look-review/
